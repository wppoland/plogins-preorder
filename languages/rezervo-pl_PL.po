msgid "Pre-order"
msgstr "Przedsprzedaż"

#: src/Admin/ProductDataPanel.php:33
msgid ""
"Sell this product as a pre-order. It stays purchasable even when out of "
"stock."
msgstr ""
"Sprzedawaj ten produkt w przedsprzedaży. Pozostaje dostępny do kupienia "
"nawet po wyczerpaniu zapasów."

#: src/Admin/ProductDataPanel.php:38
msgid "Expected release date"
msgstr ""

