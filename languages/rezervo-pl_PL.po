#. Plugin Name of the plugin
#: rezervo.php
msgid "Rezervo - Pre-Orders for WooCommerce"
msgstr "Plogins Preorder - Przedsprzedaż dla WooCommerce"

#. Plugin URI of the plugin
#: rezervo.php
msgid "https://plogins.com/plogins-preorder/"
msgstr ""

#. Description of the plugin
#: rezervo.php
msgid ""
"Let customers pre-order upcoming or out-of-stock WooCommerce products with a "
"custom add-to-cart button."
msgstr ""
"Pozwól klientom zamawiać w przedsprzedaży nadchodzące lub niedostępne "
"produkty WooCommerce dzięki niestandardowemu przyciskowi dodawania do "
"koszyka."

#. Author of the plugin
#: rezervo.php
msgid "WPPoland.com"
msgstr ""

#. Author URI of the plugin
#: rezervo.php
msgid "https://wppoland.com"
msgstr ""

